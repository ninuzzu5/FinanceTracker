# Telegram — never commit real values
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# Supabase — use only public values in the web app
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bot only — authenticated user credentials, never expose to the browser
SUPABASE_USER_EMAIL=
SUPABASE_USER_PASSWORD=

# Defaults
APP_TIMEZONE=Europe/Rome
DEFAULT_ACCOUNT=revolut
