# Configurazione pubblica del browser. Nessuna password o chiave privilegiata.
VITE_SUPABASE_URL=
# Preferire una chiave publishable; è ammessa anche una chiave legacy anon.
VITE_SUPABASE_PUBLISHABLE_KEY=
# UUID pubblico di un account web distinto da quello del bot, verificato in console.
VITE_SUPABASE_WEB_USER_ID=
